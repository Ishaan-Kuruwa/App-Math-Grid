---
import Layout from '../layouts/Layout.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';
import { heading, link } from '../lib/styles';

const levels = [
  { difficulty: 'intro', text: 'A good first project. The math and the papers are the most approachable.' },
  { difficulty: 'intermediate', text: 'Combines a few ideas or takes more setup, like a solver or a simulation.' },
  { difficulty: 'advanced', text: 'Harder math and papers. Best after you have done a project before.' },
] as const;
---

<Layout title="About" description="What the Applied Math Method Map is and how to use it to start a research project.">
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight">About the map</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      Math shows up in almost every kind of research, from tracking disease outbreaks to planning sports strategy.
      This map shows where. Each row is a math method, each column is a research field, and each filled square is an
      entry that explains how researchers use that method in that field.
    </p>

    <h2 class:list={[heading, 'mt-10']}>How to use it</h2>
    <ol class="mt-4 list-decimal space-y-2 pl-6 leading-relaxed text-slate-700 dark:text-slate-300">
      <li>Pick a field you care about, or a method you're learning in class.</li>
      <li>Open an entry in that row or column.</li>
      <li>Read the first paper listed. Papers are ordered from easiest to hardest to read.</li>
      <li>Try the starter question. It's a small project you can begin with real or made-up data.</li>
    </ol>

    <h2 class:list={[heading, 'mt-10']}>Difficulty levels</h2>
    <dl class="mt-4 space-y-3">
      {
        levels.map(({ difficulty, text }) => (
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
            <dt class="shrink-0 sm:w-28">
              <DifficultyBadge difficulty={difficulty} />
            </dt>
            <dd class="leading-relaxed text-slate-700 dark:text-slate-300">{text}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 leading-relaxed text-slate-700 dark:text-slate-300">
      Every entry also lists the exact math it uses under “What you should know first.”
    </p>

    <h2 class:list={[heading, 'mt-10']}>Where the papers come from</h2>
    <p class="mt-4 leading-relaxed text-slate-700 dark:text-slate-300">
      Every paper on the map is a real, published study. We check each one against OpenAlex, a large database of
      scholarly research, to confirm its title, authors, and year. A club member also reviews every entry before it
      goes on the site.
    </p>

    <h2 class:list={[heading, 'mt-10']}>Who runs it</h2>
    <p class="mt-4 leading-relaxed text-slate-700 dark:text-slate-300">
      The map is built and run by our school's STEM research club, for students starting their first research project.
    </p>

    <a href="/" class:list={[link, 'mt-10 inline-block']}>← Back to the map</a>
  </main>
</Layout>
