---
import type { GetStaticPaths } from 'astro';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import Layout from '../../layouts/Layout.astro';
import { isDraft } from '../../lib/entries';
import { getGridData, type Method } from '../../lib/grid';

// Every method gets a page, even with no entries yet: its open fields are the point.
export const getStaticPaths = (async () => {
  const { methods } = await getGridData();
  return methods.map((method) => ({ params: { slug: method.data.slug }, props: { method } }));
}) satisfies GetStaticPaths;

interface Props {
  method: Method;
}

const { method } = Astro.props;
const { name, slug, description, prerequisites } = method.data;

// Same visibility rules as the grid: getGridData only returns drafts in `astro dev`.
const { fields, cellFor } = await getGridData();
const filled = fields.flatMap((field) => {
  const entry = cellFor(slug, field.data.slug);
  return entry ? [{ field, entry }] : [];
});
const open = fields.filter((field) => !cellFor(slug, field.data.slug));

const link =
  'rounded font-medium text-indigo-700 underline underline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:text-indigo-300 dark:hover:text-indigo-100 dark:focus-visible:outline-indigo-400';
const heading = 'text-xl font-semibold tracking-tight';
const focus =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:focus-visible:outline-indigo-400';
---

<Layout title={`${name} · Applied Math Method Map`}>
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <a href="/" class={link}>← Back to the map</a>

    <header class="mt-6 space-y-3">
      <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-400">
        Method
      </p>
      <h1 class="text-3xl font-bold tracking-tight">{name}</h1>
      <p class="text-lg leading-relaxed">{description}</p>
    </header>

    {
      prerequisites.length > 0 && (
        <section class="mt-8">
          <h2 class={heading}>What you should know first</h2>
          <ul class="mt-3 list-disc space-y-1 pl-6">
            {prerequisites.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-8">
      <h2 class={heading}>Fields that use this method</h2>
      {
        filled.length === 0 ? (
          <p class="mt-3 text-slate-700 dark:text-slate-300">
            No entries yet. Every field below is open for a contribution.
          </p>
        ) : (
          <div class="mt-3 space-y-6">
            {filled.map(({ field, entry }) => (
              <section>
                <h3 class="font-semibold">
                  <a href={`/field/${field.data.slug}`} class={link}>
                    {field.data.name}
                  </a>
                </h3>
                <a
                  href={`/entry/${entry.id}`}
                  class:list={[
                    'mt-2 block rounded-lg border border-slate-300 bg-white p-4 shadow-sm transition-colors hover:border-indigo-500 hover:bg-indigo-50',
                    'dark:border-slate-700 dark:bg-slate-900 dark:hover:border-indigo-400 dark:hover:bg-slate-800',
                    focus,
                  ]}
                >
                  <span class="block font-medium">{entry.data.title}</span>
                  <span class="mt-2 flex flex-wrap gap-1">
                    <DifficultyBadge difficulty={entry.data.difficulty} />
                    {isDraft(entry) && <DraftBadge />}
                  </span>
                </a>
              </section>
            ))}
          </div>
        )
      }
    </section>

    {
      open.length > 0 && (
        <section class="mt-8">
          <h2 class={heading}>Open fields</h2>
          <p class="mt-2 text-slate-700 dark:text-slate-300">
            Nobody has written an entry for this method in these fields yet. Want to be the first?
          </p>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {open.map((field) => (
              <li>
                <a
                  href="/contribute"
                  aria-label={`Open: ${name} in ${field.data.name}. Contribute an entry`}
                  class:list={[
                    'flex items-center justify-between gap-3 rounded-lg border border-dashed border-slate-300 p-3 text-sm text-slate-600 transition-colors hover:border-slate-500 hover:text-slate-900',
                    'dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-100',
                    focus,
                  ]}
                >
                  <span class="font-medium">{field.data.name}</span>
                  <span>Open — contribute</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <a href="/" class:list={[link, 'mt-10 inline-block']}>← Back to the map</a>
  </main>
</Layout>
