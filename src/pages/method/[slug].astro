---
import type { GetStaticPaths } from 'astro';
import DetailPage from '../../components/DetailPage.astro';
import EntryGroupList from '../../components/EntryGroupList.astro';
import OpenCellList from '../../components/OpenCellList.astro';
import { getGridData, type Method } from '../../lib/grid';
import { heading } from '../../lib/styles';

// Every method gets a page, even with no entries yet: its open fields are the point.
export const getStaticPaths = (async () => {
  const { methods } = await getGridData();
  return methods.map((method) => ({ params: { slug: method.data.slug }, props: { method } }));
}) satisfies GetStaticPaths;

interface Props {
  method: Method;
}

const { method } = Astro.props;
const { name, slug, description, prerequisites } = method.data;

// Same visibility rules as the grid: getGridData only returns drafts in `astro dev`.
const { fields, cellFor } = await getGridData();
const filled = fields.flatMap((field) => {
  const entry = cellFor(slug, field.data.slug);
  return entry ? [{ name: field.data.name, href: `/field/${field.data.slug}`, entry }] : [];
});
const open = fields
  .filter((field) => !cellFor(slug, field.data.slug))
  .map((field) => ({ label: field.data.name, methodName: name, fieldName: field.data.name }));
---

<DetailPage
  kind="Method"
  name={name}
  description={description}
  metaDescription={`${name} in applied research: the fields that use it, starter research questions, and open spots to contribute an entry.`}
>
  {
    prerequisites.length > 0 && (
      <section class="mt-8">
        <h2 class={heading}>What you should know first</h2>
        <ul class="mt-3 list-disc space-y-1 pl-6">
          {prerequisites.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )
  }

  <EntryGroupList
    title="Fields that use this method"
    emptyText="No entries yet. Every field below is open for a contribution."
    groups={filled}
  />

  <OpenCellList
    title="Open fields"
    intro="Nobody has written an entry for this method in these fields yet. Want to be the first?"
    cells={open}
  />
</DetailPage>
