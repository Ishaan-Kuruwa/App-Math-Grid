---
import Layout from '../layouts/Layout.astro';
import { link } from '../lib/styles';
---

<Layout title="Page not found" description="This page doesn't exist on the Applied Math Method Map.">
  <main class="motion-safe:animate-fade-up mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      We couldn't find that page. It may have moved, or the link may have a typo. You can search
      above or go back to the map to find a method and field.
    </p>
    <a href="/" class:list={[link, 'mt-8 inline-block']}>← Back to the map</a>
  </main>
</Layout>
