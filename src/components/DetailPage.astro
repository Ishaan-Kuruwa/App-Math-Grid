---
import Layout from '../layouts/Layout.astro';
import { fadeUp, link } from '../lib/styles';

// Shell for the method and field pages: back links, then a header with the
// kind of page ("Method" / "Field"), its name, and its description.
// The main element is what Pagefind indexes for search (see Search.astro).

interface Props {
  kind: string;
  name: string;
  description: string;
  /** One sentence for the meta description. */
  metaDescription: string;
}

const { kind, name, description, metaDescription } = Astro.props;
---

<Layout title={name} description={metaDescription}>
  <main
    class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8"
    data-pagefind-body
    data-pagefind-meta={`type:${kind.toLowerCase()}`}
  >
    <a href="/" class={link} data-pagefind-ignore>← Back to the map</a>

    <header class:list={['mt-6 space-y-3', fadeUp]}>
      <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-400">
        {kind}
      </p>
      <h1 class="text-3xl font-bold tracking-tight">{name}</h1>
      <p class="text-lg leading-relaxed">{description}</p>
    </header>

    <slot />

    <a href="/" class:list={[link, 'mt-10 inline-block']} data-pagefind-ignore>← Back to the map</a>
  </main>
</Layout>
