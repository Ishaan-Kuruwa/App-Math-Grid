---
import type { Entry } from '../lib/entries';
import { isDraft } from '../lib/entries';
import { entryTitleTransition, fadeDelay, fadeUp, focus, lift } from '../lib/styles';
import DifficultyBadge from './DifficultyBadge.astro';
import DraftBadge from './DraftBadge.astro';

interface Props {
  entry: Entry | undefined;
  methodName: string;
  fieldName: string;
  /** Position in the load-in wave; each step delays the fade-in a little. */
  order?: number;
}

const { entry, methodName, fieldName, order = 0 } = Astro.props;

const base = [
  'flex h-full min-h-24 flex-col justify-between gap-4 rounded-lg border p-cell text-sm md:min-h-36',
  lift,
  fadeUp,
  focus,
];
const delay = fadeDelay(order);

// Set by DifficultyFilter when this entry's difficulty is filtered out. Dims with
// muted colors and grayscale rather than opacity, so the text still meets WCAG AA.
// The change fades over the same 300ms as `lift` because both use `transition`.
const dimmed =
  'data-dimmed:border-line data-dimmed:bg-canvas data-dimmed:text-ink-muted data-dimmed:shadow-none data-dimmed:grayscale';
---

{
  entry ? (
    <a
      href={`/entry/${entry.id}`}
      data-cell-difficulty={entry.data.difficulty}
      style={delay}
      class:list={[
        base,
        'border-line bg-surface text-ink shadow-card',
        'hover:border-brand focus-visible:border-brand',
        dimmed,
      ]}
    >
      <span
        transition:name={entryTitleTransition(entry.id)}
        class="line-clamp-4 font-display text-[0.9375rem] leading-snug font-semibold [view-transition-class:entry-title]"
      >
        {entry.data.title}
      </span>
      <span class="flex flex-wrap gap-1.5">
        <DifficultyBadge difficulty={entry.data.difficulty} />
        {isDraft(entry) && <DraftBadge />}
      </span>
    </a>
  ) : (
    <a
      href="/contribute"
      aria-label={`Open: ${methodName} in ${fieldName}. Contribute an entry`}
      style={delay}
      class:list={[
        base,
        'items-center justify-center border-dashed border-line-strong text-center text-ink-muted',
        'hover:border-brand hover:bg-brand-soft hover:text-ink focus-visible:border-brand',
      ]}
    >
      Open — contribute
    </a>
  )
}
