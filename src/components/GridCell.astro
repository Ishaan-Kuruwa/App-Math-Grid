---
import type { Entry } from '../lib/entries';
import { isDraft } from '../lib/entries';
import DifficultyBadge from './DifficultyBadge.astro';
import DraftBadge from './DraftBadge.astro';

interface Props {
  entry: Entry | undefined;
  methodName: string;
  fieldName: string;
}

const { entry, methodName, fieldName } = Astro.props;

const base =
  'flex h-full min-h-28 flex-col justify-between gap-2 rounded-lg border p-3 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:focus-visible:outline-indigo-400';
---

{
  entry ? (
    <a
      href={`/entry/${entry.id}`}
      class:list={[
        base,
        'border-slate-300 bg-white font-medium text-slate-900 shadow-sm hover:border-indigo-500 hover:bg-indigo-50',
        'dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-indigo-400 dark:hover:bg-slate-800',
      ]}
    >
      <span class="line-clamp-3">{entry.data.title}</span>
      <span class="flex flex-wrap gap-1">
        <DifficultyBadge difficulty={entry.data.difficulty} />
        {isDraft(entry) && <DraftBadge />}
      </span>
    </a>
  ) : (
    <a
      href="/contribute"
      aria-label={`Open: ${methodName} in ${fieldName}. Contribute an entry`}
      class:list={[
        base,
        'items-center justify-center border-dashed border-slate-300 text-center text-slate-600 hover:border-slate-500 hover:text-slate-900',
        'dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-100',
      ]}
    >
      Open — contribute
    </a>
  )
}
