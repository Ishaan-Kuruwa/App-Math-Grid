---
import { badgeBase, difficultyStyles, type Difficulty } from '../lib/difficulty';

// Use this badge on every page that shows a difficulty. Colors live in
// lib/difficulty.ts so the search results can share them.

interface Props {
  difficulty: Difficulty;
}

const { difficulty } = Astro.props;
const { label, classes } = difficultyStyles[difficulty];
---

<span class:list={[badgeBase, classes]}>
  {label}
</span>
