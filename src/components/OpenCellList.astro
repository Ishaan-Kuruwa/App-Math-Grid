---
import { focus, heading } from '../lib/styles';

// Open cells on a detail page, each linking to /contribute. Renders nothing when
// every cell is filled.

interface Props {
  title: string;
  intro: string;
  cells: { label: string; methodName: string; fieldName: string }[];
}

const { title, intro, cells } = Astro.props;
---

{
  cells.length > 0 && (
    <section class="mt-8">
      <h2 class={heading}>{title}</h2>
      <p class="mt-2 text-slate-700 dark:text-slate-300">{intro}</p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {cells.map(({ label, methodName, fieldName }) => (
          <li>
            <a
              href="/contribute"
              aria-label={`Open: ${methodName} in ${fieldName}. Contribute an entry`}
              class:list={[
                'flex items-center justify-between gap-3 rounded-lg border border-dashed border-slate-300 p-3 text-sm text-slate-600 transition-colors hover:border-slate-500 hover:text-slate-900',
                'dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-100',
                focus,
              ]}
            >
              <span class="font-medium">{label}</span>
              <span>Open — contribute</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
