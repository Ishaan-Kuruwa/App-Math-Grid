---
import { fadeDelay, fadeUp, focus, heading, lift } from '../lib/styles';

// Open cells on a detail page, each linking to /contribute. Renders nothing when
// every cell is filled.

interface Props {
  title: string;
  intro: string;
  cells: { label: string; methodName: string; fieldName: string }[];
}

const { title, intro, cells } = Astro.props;
---

{
  cells.length > 0 && (
    <section class="mt-8">
      <h2 class={heading}>{title}</h2>
      <p class="mt-2 text-ink-muted">{intro}</p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {cells.map(({ label, methodName, fieldName }, index) => (
          <li class={fadeUp} style={fadeDelay(index)}>
            <a
              href="/contribute"
              aria-label={`Open: ${methodName} in ${fieldName}. Contribute an entry`}
              class:list={[
                'flex items-center justify-between gap-3 rounded-lg border border-dashed border-line-strong p-4 text-sm text-ink-muted',
                'hover:border-brand hover:bg-brand-soft hover:text-ink focus-visible:border-brand',
                lift,
                focus,
              ]}
            >
              <span class="font-medium">{label}</span>
              <span>Open — contribute</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
