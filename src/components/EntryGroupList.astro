---
import { isDraft, type Entry } from '../lib/entries';
import { focus, heading, link } from '../lib/styles';
import DifficultyBadge from './DifficultyBadge.astro';
import DraftBadge from './DraftBadge.astro';

// Filled cells on a detail page: one group per other-axis item (a field on a
// method page, a method on a field page), each with a link to that item's page
// and a card linking to the entry.

interface Props {
  title: string;
  emptyText: string;
  groups: { name: string; href: string; entry: Entry }[];
}

const { title, emptyText, groups } = Astro.props;
---

<section class="mt-8">
  <h2 class={heading}>{title}</h2>
  {
    groups.length === 0 ? (
      <p class="mt-3 text-slate-700 dark:text-slate-300">{emptyText}</p>
    ) : (
      <div class="mt-3 space-y-6">
        {groups.map(({ name, href, entry }) => (
          <section>
            <h3 class="font-semibold">
              <a href={href} class={link}>
                {name}
              </a>
            </h3>
            <a
              href={`/entry/${entry.id}`}
              class:list={[
                'mt-2 block rounded-lg border border-slate-300 bg-white p-4 shadow-sm transition-colors hover:border-indigo-500 hover:bg-indigo-50',
                'dark:border-slate-700 dark:bg-slate-900 dark:hover:border-indigo-400 dark:hover:bg-slate-800',
                focus,
              ]}
            >
              <span class="block font-medium">{entry.data.title}</span>
              <span class="mt-2 flex flex-wrap gap-1">
                <DifficultyBadge difficulty={entry.data.difficulty} />
                {isDraft(entry) && <DraftBadge />}
              </span>
            </a>
          </section>
        ))}
      </div>
    )
  }
</section>
