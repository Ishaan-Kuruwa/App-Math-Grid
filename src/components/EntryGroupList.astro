---
import { isDraft, type Entry } from '../lib/entries';
import { entryTitleTransition, fadeDelay, fadeUp, focus, heading, lift, link } from '../lib/styles';
import DifficultyBadge from './DifficultyBadge.astro';
import DraftBadge from './DraftBadge.astro';

// Filled cells on a detail page: one group per other-axis item (a field on a
// method page, a method on a field page), each with a link to that item's page
// and a card linking to the entry.

interface Props {
  title: string;
  emptyText: string;
  groups: { name: string; href: string; entry: Entry }[];
}

const { title, emptyText, groups } = Astro.props;
---

<section class="mt-8">
  <h2 class={heading}>{title}</h2>
  {
    groups.length === 0 ? (
      <p class="mt-3 text-ink-muted">{emptyText}</p>
    ) : (
      <div class="mt-3 space-y-6">
        {groups.map(({ name, href, entry }, index) => (
          <section class={fadeUp} style={fadeDelay(index, 60)}>
            <h3 class="font-semibold">
              <a href={href} class={link}>
                {name}
              </a>
            </h3>
            <a
              href={`/entry/${entry.id}`}
              class:list={[
                'mt-2 block rounded-xl border border-line bg-surface p-card shadow-card hover:border-brand focus-visible:border-brand',
                lift,
                focus,
              ]}
            >
              <span
                transition:name={entryTitleTransition(entry.id)}
                class="block font-display font-semibold [view-transition-class:entry-title]"
              >
                {entry.data.title}
              </span>
              <span class="mt-3 flex flex-wrap gap-1.5">
                <DifficultyBadge difficulty={entry.data.difficulty} />
                {isDraft(entry) && <DraftBadge />}
              </span>
            </a>
          </section>
        ))}
      </div>
    )
  }
</section>
