---
import { fieldAccent } from '../lib/fields';
import type { GridData } from '../lib/grid';
import { focus } from '../lib/styles';
import GridCell from './GridCell.astro';

// Mobile layout (below 768px): the grid grouped by field, one collapsible section each.
// `data-animate` opts into the smooth open/close in global.css.

type Props = GridData;

const { methods, fields, cellFor } = Astro.props;

const link = ['rounded underline-offset-4 hover:underline', focus];
---

<div class="space-y-4 md:hidden">
  {
    fields.map((field) => {
      const filled = methods.filter((method) => cellFor(method.data.slug, field.data.slug)).length;
      return (
        <details data-animate class="group rounded-xl border border-line bg-surface shadow-card">
          <summary
            class:list={[
              'flex cursor-pointer list-none items-center justify-between gap-3 rounded-xl p-5 [&::-webkit-details-marker]:hidden',
              focus,
            ]}
          >
            <span class="flex items-center gap-3">
              <span aria-hidden="true" class:list={['size-2.5 shrink-0 rounded-full', fieldAccent[field.data.slug]]} />
              <span class="font-display font-semibold">{field.data.name}</span>
            </span>
            <span class="flex shrink-0 items-center gap-3 text-sm text-ink-muted">
              {filled} of {methods.length} filled
              <span
                aria-hidden="true"
                class="transition-transform duration-300 ease-soft group-open:rotate-180 motion-reduce:transition-none"
              >
                ▾
              </span>
            </span>
          </summary>
          <div class="space-y-6 border-t border-line p-5">
            <a href={`/field/${field.data.slug}`} class:list={[link, 'text-sm font-medium text-brand']}>
              See all methods in {field.data.name} →
            </a>
            <ul class="space-y-5">
              {methods.map((method) => (
                <li class="space-y-2">
                  <a href={`/method/${method.data.slug}`} class:list={[link, 'font-display text-sm font-semibold']}>
                    {method.data.name}
                  </a>
                  <GridCell
                    entry={cellFor(method.data.slug, field.data.slug)}
                    methodName={method.data.name}
                    fieldName={field.data.name}
                  />
                </li>
              ))}
            </ul>
          </div>
        </details>
      );
    })
  }
</div>
