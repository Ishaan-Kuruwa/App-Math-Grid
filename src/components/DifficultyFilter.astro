---
import { DIFFICULTIES } from '../content.config';
import { difficultyStyles } from '../lib/difficulty';
import { focus } from '../lib/styles';

// Homepage difficulty filter. Each button toggles one difficulty on or off;
// grid cells whose difficulty is off are dimmed (see GridCell) so the grid keeps
// its shape. The controls start hidden and the script reveals them, so without
// JavaScript there are no dead buttons and every entry shows normally.

// Off state: neutral outline instead of the difficulty color. The ✓ also
// disappears, so the state doesn't rely on color alone.
const off =
  'aria-[pressed=false]:border-line-strong aria-[pressed=false]:bg-surface aria-[pressed=false]:text-ink-muted';
---

<div
  role="group"
  aria-labelledby="difficulty-filter-label"
  class="mb-8 flex flex-wrap items-center gap-2.5"
  data-difficulty-filter
  hidden
>
  <span id="difficulty-filter-label" class="mr-2 text-sm font-semibold">Show difficulty:</span>
  {
    DIFFICULTIES.map((difficulty) => {
      const { label, classes } = difficultyStyles[difficulty];
      return (
        <button
          type="button"
          aria-pressed="true"
          data-difficulty-toggle={difficulty}
          class:list={[
            'group inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-transparent px-4 py-2 text-sm font-semibold',
            'transition duration-200 ease-soft hover:border-brand motion-safe:active:scale-95',
            classes,
            off,
            focus,
          ]}
        >
          <span aria-hidden="true" class="w-3 group-aria-[pressed=false]:invisible">
            ✓
          </span>
          {label}
        </button>
      );
    })
  }
  <p role="status" aria-live="polite" class="sr-only" data-difficulty-status></p>
</div>

<script>
  // With View Transitions this script runs once, so set the filter up again each
  // time a page loads or is swapped in. The page swap brings fresh, unpressed
  // buttons, so the filter starts from "show all" just like a full reload.
  function setUp() {
    const group = document.querySelector<HTMLElement>('[data-difficulty-filter]');

    if (group) {
      const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-difficulty-toggle]')];
      const status = group.querySelector<HTMLElement>('[data-difficulty-status]')!;
      // Each entry appears twice in the page (desktop grid and mobile accordion),
      // so count only the desktop copies when announcing results.
      const cells = [...document.querySelectorAll<HTMLElement>('[data-cell-difficulty]')];
      const total = document.querySelectorAll('[data-grid] [data-cell-difficulty]').length;

      function update() {
        const shown = new Set(
          buttons
            .filter((button) => button.getAttribute('aria-pressed') === 'true')
            .map((button) => button.dataset.difficultyToggle),
        );
        for (const cell of cells) {
          cell.toggleAttribute('data-dimmed', !shown.has(cell.dataset.cellDifficulty));
        }
        const matching = document.querySelectorAll(
          '[data-grid] [data-cell-difficulty]:not([data-dimmed])',
        ).length;
        status.textContent =
          matching === total ? `Showing all ${total} entries.` : `Highlighting ${matching} of ${total} entries.`;
      }

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const pressed = button.getAttribute('aria-pressed') === 'true';
          button.setAttribute('aria-pressed', String(!pressed));
          update();
        });
      }

      group.hidden = false;
    }
  }

  document.addEventListener('astro:page-load', setUp);
</script>
