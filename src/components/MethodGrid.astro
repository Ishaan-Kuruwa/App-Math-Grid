---
import type { GridData } from '../lib/grid';
import GridCell from './GridCell.astro';

// Desktop layout (768px and up). Below that, FieldAccordion takes over.

type Props = GridData;

const { methods, fields, cellFor } = Astro.props;

const headerLink =
  'rounded underline-offset-4 hover:text-indigo-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:hover:text-indigo-300 dark:focus-visible:outline-indigo-400';
---

<div class="hidden overflow-x-auto pb-2 md:block" data-grid>
  <table class="w-full min-w-[72rem] table-fixed border-separate border-spacing-0">
    <caption class="sr-only">Applied math methods (rows) by research field (columns)</caption>
    <colgroup>
      <col class="w-40" />
      {fields.map(() => <col />)}
    </colgroup>
    <thead>
      <tr>
        <td class="sticky left-0 z-10 bg-white dark:bg-slate-950"></td>
        {
          fields.map((field) => (
            <th scope="col" class="px-1 pb-3 text-left align-bottom text-sm font-semibold">
              <a href={`/field/${field.data.slug}`} class={headerLink}>
                {field.data.name}
              </a>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        methods.map((method) => (
          <tr>
            <th
              scope="row"
              class="sticky left-0 z-10 bg-white py-1 pr-3 text-left align-middle text-sm font-semibold dark:bg-slate-950"
            >
              <a href={`/method/${method.data.slug}`} class={headerLink}>
                {method.data.name}
              </a>
            </th>
            {fields.map((field) => (
              <td class="h-px p-1 align-top">
                <GridCell
                  entry={cellFor(method.data.slug, field.data.slug)}
                  methodName={method.data.name}
                  fieldName={field.data.name}
                />
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
