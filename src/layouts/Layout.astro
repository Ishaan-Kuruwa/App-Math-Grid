---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Search from '../components/Search.astro';
import { focus } from '../lib/styles';

const siteName = 'Applied Math Method Map';

interface Props {
	/** Page-specific part of the title; the site name is appended. Omit on the home page. */
	title?: string;
	/** One sentence for the meta description. */
	description: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-canvas font-sans text-ink antialiased">
		<!-- Named so it stays put while the page below it cross-fades -->
		<header transition:name="site-header" class="sticky top-0 z-40 border-b border-line bg-canvas/80 backdrop-blur-md">
			<div class="mx-auto flex max-w-screen-2xl flex-col gap-4 px-gutter py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
				<a href="/" class:list={['rounded font-display text-lg font-bold tracking-tight', focus]}>
					Applied <span class="text-brand">Math</span> Method Map
				</a>
				<div class="flex w-full items-center gap-6 sm:w-auto">
					<a
						href="/about"
						class:list={['rounded text-sm font-medium text-ink-muted transition-colors hover:text-ink', focus]}
					>
						About
					</a>
					<Search />
				</div>
			</div>
		</header>
		<slot />
	</body>
</html>
